---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { categoriesWithSounds, categoryPath, getCatalog, soundPath, type CatalogCategory, type CatalogCollection } from '../../../lib/catalog';
import { breadcrumbLd } from '../../../lib/seo';

// Una página por categoría con sonidos: /animales/granja/, /animales/aves/…
// Si la colección solo tiene una categoría, no hace falta esta página intermedia:
// el hub de la colección ya lista los sonidos directamente (ver [collection]/index.astro).
export const getStaticPaths = (async () => {
  const catalog = await getCatalog();
  return catalog.flatMap((c) => {
    const cats = categoriesWithSounds(c);
    if (cats.length < 2) return [];
    return cats.map((k) => ({ params: { collection: c.id, category: k.id }, props: { collection: c, category: k } }));
  });
}) satisfies GetStaticPaths;

const { collection, category } = Astro.props as { collection: CatalogCollection; category: CatalogCategory & { count: number } };
const site = Astro.site!;
const sounds = collection.sounds.filter((s) => s.category === category.id);
const collLabel = collection.name.toLocaleLowerCase('es');
const catLabel = category.name.toLocaleLowerCase('es');
const path = categoryPath(collection, category);
const title = `Sonidos de ${collLabel} de ${catLabel} | ¿Qué suena?`;
const description = `Escucha ${sounds.length} sonidos reales de ${catLabel} (categoría de ${collLabel}) y adivina cuál es. Son grabaciones con licencia abierta, gratis y sin registro.`;

// Con menos de 4 sonidos no hay distractores suficientes para el modo juego: se oculta el botón de la categoría.
const playCategoryHref = `/?coleccion=${collection.id}&categoria=${category.id}`;
const showCategoryPlay = category.count >= 4;
---
<Base
  title={title}
  description={description}
  path={path}
  jsonLd={[
    breadcrumbLd([
      { name: 'Inicio', url: new URL('/', site).href },
      { name: collection.name, url: new URL(`/${collection.id}/`, site).href },
      { name: category.name, url: new URL(path, site).href },
    ]),
  ]}
>
  <main class="page">
    <Breadcrumbs items={[{ name: 'Inicio', href: '/' }, { name: collection.name, href: `/${collection.id}/` }, { name: category.name }]} />
    <h1 class="page-title">Sonidos de {catLabel}</h1>
    <p class="page-lead">
      {sounds.length} sonidos reales de {catLabel}, de la colección {collLabel}. Toca uno para escucharlo y ver el autor de la grabación y su licencia.
    </p>
    <div class="play-block">
      <a class="pill pill-link" href="/">Juega a adivinar</a>
      {showCategoryPlay && (
        <a class="pill pill-link" href={playCategoryHref}>Juega a adivinar (solo {catLabel})</a>
      )}
    </div>

    <ul class="sound-links sound-links-emoji category-sounds">
      {sounds.map((s) => (
        <li><a href={soundPath(s)}><span aria-hidden="true">{s.emoji}</span> {s.name}</a></li>
      ))}
    </ul>
  </main>
</Base>
