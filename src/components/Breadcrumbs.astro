---
/* Migas de pan visibles. La última es la página actual y no es un enlace. */
interface Props {
  items: { name: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Migas de pan">
  <ol>
    {items.map((it, i) => (
      <li>
        {it.href && i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
