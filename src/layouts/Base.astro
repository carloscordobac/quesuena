---
import '@fontsource-variable/dynapuff/wdth.css';
import '@fontsource-variable/figtree/wght.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { ANALYTICS_ENABLED } from '../lib/site';
import { getCatalog } from '../lib/catalog';
// URLs con hash de las fuentes latin (las mismas que usa el CSS): se precargan porque salen en la primera pintura.
import dynapuffLatin from '@fontsource-variable/dynapuff/files/dynapuff-latin-wdth-normal.woff2?url';
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Ruta canónica, p. ej. «/» o «/creditos/». */
  path?: string;
  /** Páginas que no deben indexarse (404): sin canónica ni og:url y con robots noindex. */
  noindex?: boolean;
  /** Tono (0-359) con el que se tiñe la página, como hace la app con cada categoría. */
  tone?: number;
  /** Datos estructurados (JSON-LD) de la página. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title = '¿Qué suena? Un sonido al azar, ¿sabes qué es?',
  description = 'Toca el círculo y escucha un sonido real al azar: animales y más colecciones. ¿Sabes qué es?',
  path = '/',
  noindex = false,
  tone,
  jsonLd = [],
} = Astro.props;

const canonical = new URL(path, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// Menú: Inicio, una colección por cada una con sonidos, Créditos y Privacidad.
const catalog = await getCatalog();
---
<!doctype html>
<html lang="es" data-tone={tone === undefined ? undefined : 'on'} style={tone === undefined ? undefined : `--h: ${tone}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="preload" href={dynapuffLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />

    <meta name="theme-color" content="#F7F8FB" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131A2B" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="¿Qué suena?" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="¿qué suena? Un sonido al azar. ¿Sabes qué es?" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    {ANALYTICS_ENABLED && <ConsentBanner />}
    <header class="top">
      <div class="top-inner">
        <a class="brand" href="/" aria-label="¿Qué suena? Ir al inicio">
          <Logo size={34} dot="var(--ink)" />
          <span class="brand-word">¿qué suena?</span>
        </a>
        <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav" hidden>
          <svg class="nav-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
          <span class="nav-toggle-label">Menú</span>
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Principal">
          <a href="/">Inicio</a>
          {catalog.map((c) => <a href={`/${c.id}/`}>{c.name}</a>)}
          <a href="/creditos/">Créditos</a>
          <a href="/privacidad/">Privacidad</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="foot">
      <div class="foot-inner">
        <div class="foot-logos">
          <img src="/img/desarrollo-creativo-oscuro.png" alt="Desarrollo Creativo" width="800" height="269" loading="lazy" decoding="async" />
          <a href="https://ccordoba.es" rel="noopener">
            <img src="/img/ccordoba.png" alt="ccordoba.es" width="1084" height="164" loading="lazy" decoding="async" />
          </a>
        </div>
        <nav class="foot-legal" aria-label="Información legal">
          <a href="/creditos/">Créditos de los sonidos</a>
          <a href="/privacidad/">Privacidad</a>
          {ANALYTICS_ENABLED && <button type="button" class="foot-link" data-consent-open hidden>Cookies</button>}
        </nav>
      </div>
    </footer>
    {ANALYTICS_ENABLED && <script>import '../scripts/consent.ts';</script>}
    <script>import '../scripts/nav.ts';</script>
  </body>
</html>
